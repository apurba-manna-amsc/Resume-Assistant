GROQ_API_KEY=your_groq_api_key_here

# Default model (must be in your Groq account; loaded from /v1/models)
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# Comma-separated model IDs to show as (Free) in the UI
GROQ_FREE_MODEL_IDS=llama-3.3-70b-versatile,llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-20b

# Rate limiting: wait when remaining quota is low (uses Groq response headers)
GROQ_MIN_REMAINING_REQUESTS=2
GROQ_MIN_REMAINING_TOKENS_RATIO=0.15
GROQ_MIN_REQUEST_INTERVAL_SEC=1.0
GROQ_RATE_LIMIT_BUFFER_SEC=0.5
GROQ_RETRY_DELAY_SEC=10

# When 1, selecting a model triggers a tiny API call to load rate-limit headers
GROQ_PROBE_RATE_LIMIT_ON_SELECT=1
